# --- Models (Claude). Bedrock preferred; Anthropic API as fallback ---
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
ANTHROPIC_API_KEY=

# --- Web search for the buyer swarm ---
KEENABLE_API_KEY=

# --- ElevenLabs voice agent ---
# Key needs ElevenAgents write access (convai_write).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Phone calls only (browser calls need neither): a Twilio number imported into ElevenLabs.
ELEVENLABS_PHONE_NUMBER_ID=
# Demo phone calls ring this number (your own phone, E.164 like +14155550123).
DEMO_CALL_NUMBER=
# Leave empty. Set to 1 only when approved calls may ring real buyers.
LIVE_CALLS_ENABLED=

# --- Server ---
# Public https URL that reaches this server, so ElevenLabs can call /api/price-check.
# Locally: cloudflared tunnel --url http://localhost:4320
PUBLIC_BASE_URL=
# Required header x-voice-key for endpoints that spend credits or place calls.
VOICE_ACCESS_KEY=
VOICE_PORT=4320

# --- Optional storage on a dedicated Archil disk (default: ./data) ---
# Never point this at the outreach or scout disks.
ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-east-1
VOICE_ARCHIL_DISK_ID=
