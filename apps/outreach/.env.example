ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-east-1
# Required for Archil storage: set your own outreach disk ID.
ARCHIL_DISK_ID=
ARCHIL_PREFIX=autonomous-sourcing/v1/
# Optional read-only RFQ Scout disk. The fictional sample is available without it.
SCOUT_DISK_ID=
KEENABLE_API_KEY=
AGENTMAIL_API_KEY=
# Optional existing inbox (otherwise Connect inbox provisions one):
# AGENTMAIL_INBOX_ID=
# EMAIL_SENDER_NAME=Procurement team
# Local storage for testing without an Archil disk (live research still needs Archil):
# APP_STORAGE=file
# Optional: CODEX_BIN=/opt/homebrew/bin/codex
# PORT=4310
